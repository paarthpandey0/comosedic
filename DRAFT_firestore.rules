        && incoming().updatedAt == request.time
        && ownsSubjectOrGeneral(incoming().subjectId);
      allow update: if isVerified() && isValidId(sheetId)
        && existing().ownerId == request.auth.uid
        && isValidCheatSheet(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().subjectId == existing().subjectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'layoutColumns', 'sections', 'updatedAt']);
      allow delete: if isVerified() && isValidId(sheetId) && existing().ownerId == request.auth.uid;
    }

    match /gradeCourses/{courseId} {
      allow get: if isSignedIn() && isValidId(courseId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(courseId)
        && isValidGradeCourse(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsSubjectOrGeneral(incoming().subjectId);
      allow update: if isVerified() && isValidId(courseId)
        && existing().ownerId == request.auth.uid
        && isValidGradeCourse(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().subjectId == existing().subjectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'courseName', 'code', 'credits', 'targetGradePercent', 'categories', 'updatedAt'
        ]);
      allow delete: if isVerified() && isValidId(courseId) && existing().ownerId == request.auth.uid;
    }
  }
}
